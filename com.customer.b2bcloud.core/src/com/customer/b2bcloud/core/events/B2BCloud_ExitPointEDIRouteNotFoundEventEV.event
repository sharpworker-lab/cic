package com.customer.b2bcloud.core.events;

def event B2BCloud_ExitPointEDIRouteNotFoundEventEV {

	def execute(StorageNode payload, EdiDataMap interchangeProperties, Long routesNotFoundCount) {
		new com.customer.b2bcloud.core.process.B2BCloud_EDIRouteNotFoundEventBPS().execute(payload, interchangeProperties,
		routesNotFoundCount)
	}

}
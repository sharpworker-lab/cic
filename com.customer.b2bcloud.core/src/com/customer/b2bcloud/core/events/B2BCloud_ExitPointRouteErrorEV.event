def event B2BCloud_ExitPointRouteErrorEV {

	def execute(StorageNode payload, EdiDataMap interchangeProperties, Array routeErrorList) {
		new com.customer.b2bcloud.core.process.B2BCloud_RouteErrorsBPS().execute(payload, interchangeProperties,

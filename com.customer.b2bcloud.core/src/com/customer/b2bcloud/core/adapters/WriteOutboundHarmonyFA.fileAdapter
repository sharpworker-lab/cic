package com.customer.b2bcloud.core.adapters;

def fileWriteAdapter WriteOutboundHarmonyFA {

	def execute(AdapterPayload storageNodes, String filename, String partnerDirectory, String protocol) {
		parentDirectory =
		"<com.customer.b2bcloud.core.B2BCloudGV.EFSMountDirectory>${protocol}\\outbox\\${partnerDirectory}"
		fileNameOrFilter = "${filename}"
		createDirectories = true
		collisionAction = GenerateUniqueName
	}

}
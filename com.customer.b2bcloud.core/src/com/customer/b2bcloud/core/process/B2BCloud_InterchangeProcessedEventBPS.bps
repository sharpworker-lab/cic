package com.customer.b2bcloud.core.process;

def bps B2BCloud_InterchangeProcessedEventBPS {

	def execute(StorageNode storageId, EdiDataMap interchangeProperties) {
		var String intCtlNbr
		var String message
		var String environment
		var String sendEmailFrom
		var String sendEmailTo
		var String subjectFull
		var String subject=" Interchange Complete Event"
		var String label1="Interchange Control #: "
		var String environment_1="<com.customer.b2bcloud.core.B2BCloudGV.Environment>"
		var String eBIHostEmail="<com.customer.b2bcloud.core.B2BCloudGV.B2BCloudHostEmail>"
		var String eBIAdministratorEmail="<com.customer.b2bcloud.core.B2BCloudGV.B2BCloudAdminEmail>"

		step {
			new ResolveGlobalVariables().execute(sendEmailFrom, eBIHostEmail)
		} next : end 
		step {
			new ResolveGlobalVariables().execute(sendEmailTo, eBIAdministratorEmail)
		} next : end 
		step {
			new ResolveGlobalVariables().execute(environment, environment_1)
		} next : end 
		step {
			new ExtractEdiInterchangeData().execute(interchangeProperties, intCtlNbr, null, null, null, null, null, null, null,
			null, null, null, null, null, null, null, null, null, null)
		} next : end 
		step {
			new AppendString().execute(message, label1, intCtlNbr)
		} next : end 
		step {
			new AppendString().execute(subjectFull, environment, subject)
		} next : end 
		step {
			new SendEmail().execute(sendEmailTo, sendEmailFrom, null, null, subjectFull, message, storageId, null)
		} end : end 
	}

}
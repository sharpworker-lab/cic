package com.customer.b2bcloud.core.process;

def bps B2BCloud_RouteErrorsBPS {

	def execute(StorageNode storageId, EdiDataMap interchangeProperties, Array RouteErrorList) {
		var String intCtlNbr
		var String errorMsg
		var String collabName
		var String message
		var Long size
		var EdiDataMap collaborationErrorProperties
		var String sendEmailTo
		var String sendEmailFrom
		var String environment
		var String subjectFull
		var String label1="Interchange Control#: "
		var String label2="\\nCollab Name: "
		var String label3="\\nError: "
		var String subject=" Inbound EDI Route Errors Event"
		var Long index=0
		var CompareType lt="Less Than (<)".asCompareType
		var Boolean ^true=true
		var String eBIAdministratorEmail="<com.customer.b2bcloud.core.B2BCloudGV.B2BCloudAdminEmail>"
		var String eBIHostEmail="<com.customer.b2bcloud.core.B2BCloudGV.B2BCloudHostEmail>"
		var String environment_1="<com.customer.b2bcloud.core.B2BCloudGV.Environment>"
		var String attachmentName

		step {
			new ResolveGlobalVariables().execute(sendEmailTo, eBIAdministratorEmail)
		} next : end 
		step {
			new ResolveGlobalVariables().execute(sendEmailFrom, eBIHostEmail)
		} next : end 
		step {
			new ResolveGlobalVariables().execute(environment, environment_1)
		} next : end 
		step {
			new ExtractEdiInterchangeData().execute(interchangeProperties, intCtlNbr, null, null, null, null, null, null, null,
			null, null, null, null, null, null, null, null, null, null)
		} next : end 
		step {
			new AppendString().execute(message, label1, intCtlNbr)
		} next : end 
		step {
			new GetArraySize().execute(RouteErrorList, size, index)
		} next : end 
		step Start {
			new CompareValues().execute(index, size, lt, null)
		} next : Exit
		step {
			new GetArrayElementAndIncrementPosition().execute(RouteErrorList, index, collaborationErrorProperties)
		} next : end 
		step {
			new ExtractEdiRouteErrorData().execute(collaborationErrorProperties, null, null, null, null, null, null, null,
			null, null, null, null, null, null, errorMsg, collabName)
		} next : end 
		step {
			new AppendString().execute(message, message, label2)
		} next : end 
		step {
			new AppendString().execute(message, message, collabName)
		} next : end 
		step {
			new AppendString().execute(message, message, label3)
		} next : end 
		step {
			new AppendString().execute(message, message, errorMsg)
		} next : end 
		step {
			new AppendString().execute(subjectFull, environment, subject)
		} Start : end 
		step AttachmentName {
			new AppendString().execute(attachmentName, intCtlNbr, ".txt")
		} next : end 
		step Exit {
			new SendEmail().execute(sendEmailTo, sendEmailFrom, null, null, subjectFull, message, storageId, attachmentName)
		} next : end 
		step {
			new SetExitStatus().execute(^true)
		} end : end 
	}

}
package com.customer.b2bcloud.core.process;

def bps B2BCloud_NoOutboundRouteErrorBPS {

	def execute(String messageType, String tpId) {
		var String sendEmailFrom
		var String sendEmailTo
		var String messageVar
		var Date date
		var String dateString
		var String environment
		var String sendEmailSubjectFull
		var String eBIHostEmail="<com.customer.b2bcloud.core.B2BCloudGV.B2BCloudHostEmail>"
		var String eBIAdministratorEmail="<com.customer.b2bcloud.core.B2BCloudGV.B2BCloudAdminEmail>"
		var String sendEmailSubject="Clarify - Invalid TP Notification:"
		var Boolean setExitStatusSuccess=true
		var Boolean setExitStatusFailure=false
		var String message1="An invalid TP of "
		var String message2=" for an outbound "
		var String message3=" was attempted to be translated in Clarify. Please review logs for details."
		var String yyyyMMddHHmmssSSS="yyyyMMddHHmmssSSS"
		var String message4="\\nTime: "
		var String environment_1="<com.customer.b2bcloud.core.B2BCloudGV.Environment>"
		var String attachmentName

		step {
			new ResolveGlobalVariables().execute(sendEmailFrom, eBIHostEmail)
		} next : Failure
		step {
			new ResolveGlobalVariables().execute(sendEmailTo, eBIAdministratorEmail)
		} next : Failure
		step {
			new ResolveGlobalVariables().execute(environment, environment_1)
		} next : Failure
		step {
			new GetCurrentDate().execute(date)
		} next : Failure
		step {
			new ConvertDateToString().execute(dateString, date, yyyyMMddHHmmssSSS)
		} next : Failure
		step {
			new AppendString().execute(messageVar, message1, tpId)
		} next : Failure
		step {
			new AppendString().execute(messageVar, messageVar, message2)
		} next : Failure
		step {
			new AppendString().execute(messageVar, messageVar, messageType)
		} next : Failure
		step {
			new AppendString().execute(messageVar, messageVar, message3)
		} next : Failure
		step {
			new AppendString().execute(messageVar, messageVar, message4)
		} next : Failure
		step {
			new AppendString().execute(messageVar, messageVar, dateString)
		} next : Failure
		step {
			new AppendString().execute(sendEmailSubjectFull, environment, sendEmailSubject)
		} next : next 
		step attachment1 {
			new AppendString().execute(attachmentName, tpId, messageType)
		} next : next 
		step {
			new AppendString().execute(attachmentName, attachmentName, ".txt")
		} next : next 
		step {
			new SendEmail().execute(sendEmailTo, sendEmailFrom, null, null, sendEmailSubjectFull, messageVar, null,
			attachmentName)
		} next : Failure
		step Success {
			new SetExitStatus().execute(setExitStatusSuccess)
		} end : end 
		step Failure {
			new SetExitStatus().execute(setExitStatusFailure)
		} end : end 
	}

}
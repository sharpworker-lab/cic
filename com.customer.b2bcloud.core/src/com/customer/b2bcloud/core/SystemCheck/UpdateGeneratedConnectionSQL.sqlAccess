#content /*sqlaccess 2 */ package com.customer.b2bcloud.core.SystemCheck;

def sqlAccess UpdateGeneratedConnectionSQL {

	def execute(String date, String generatedStatusCount) {
		bindInput(typeof(BIGINT), date)
		bindOutput(typeof(VARCHAR), generatedStatusCount)

		dataSource = new com.customer.b2bcloud.core.SystemCheck.ClarifyDatabaseDS
		statement = "update \"EBI\".\"LOG_OF_CONNECTION\" SET \"STATUS\" = \'9\' where (\"EBI\".\"LOG_OF_CONNECTION\".\"STATUS\" = \'15\')   and \"DATE\" < ${date}"

		timeout [
			timeUnit = Seconds
		]

		retry [
			timeUnit = Seconds
		]
	}
}